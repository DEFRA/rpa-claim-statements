# Template for the private env file used by compose.yaml. Copy it outside the repository, fill it in
# and restrict its file ACL to your user. It contains credentials: do not commit or share it.
# Use single quotes for values with $, # or backslashes.

ConnectionStrings__ClaimStatementsContext=

# Optional. Leave empty to disable telemetry export.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional tracking-report SMTP relay. Leave Smtp__Host empty to skip e-mail (the failure is logged).
# Credentials require Smtp__EnableSsl=true.
Smtp__Host=
Smtp__Port=
Smtp__EnableSsl=
Smtp__UserName=
Smtp__Password=

# Entra registration (Web only). The registration needs the redirect URIs
# http://localhost:<CLAIMSTATEMENTS_WEB_PORT>/signin-oidc and /signout-callback-oidc.
CLAIMSTATEMENTS_TENANT_ID=
CLAIMSTATEMENTS_CLIENT_ID=
CLAIMSTATEMENTS_CLIENT_SECRET=
CLAIMSTATEMENTS_WEB_PORT=64158

# Host folders mounted into the containers. They must be writable by container UID 1000, and the templates
# folder must contain ClaimTemplate.docx and ClaimTemplateXB.docx.
CLAIMSTATEMENTS_TEMPLATES_DIRECTORY=
CLAIMSTATEMENTS_PDF_ARCHIVE_DIRECTORY=
CLAIMSTATEMENTS_PDF_OUTBOUND_DIRECTORY=

# Optional: package source for the image build when nuget.org is not reachable, for example an internal mirror.
# NUGET_SOURCE=
