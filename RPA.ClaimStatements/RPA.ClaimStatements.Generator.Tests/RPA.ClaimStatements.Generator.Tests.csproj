<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RPA.ClaimStatements.Generator.Tests</RootNamespace>
    <AssemblyName>RPA.ClaimStatements.Generator.Tests</AssemblyName>
    <Configurations>Debug;Release;Test;SIT;Production;UAT</Configurations>
    <Platforms>AnyCPU</Platforms>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- CA1416: Windows-only by design (the Generator uses System.Drawing, WinSCP.exe and wkhtmltopdf). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Test' Or '$(Configuration)' == 'SIT'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- These files exist on disk but were never part of the legacy test build; keep them out, unchanged. -->
  <ItemGroup>
    <Compile Remove="Services\GenerationServiceTests.cs" />
    <Compile Remove="Services\ImportServiceTests.cs" />
    <Compile Remove="Services\LoadServiceTests.cs" />
    <Compile Remove="Services\LogServiceTests.cs" />
    <Compile Remove="Services\ValidationServiceTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EntityFrameworkTesting.Moq" Version="1.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPA.ClaimStatements.Generator\RPA.ClaimStatements.Generator.csproj" />
  </ItemGroup>

</Project>
