@model RPA.ClaimStatements.Generator.Models.Entities.CS.Suppression

@using (Html.BeginForm("_CreateSuppression", "Suppression", FormMethod.Post, new { @id = "frmCreateSuppression" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="row" style="margin-bottom:10px;">
        <div class="form-group">
            @Html.LabelFor(model => model.FRN, new { @class = "control-label col-md-3" })
            <div class="col-md-7">
                @Html.TextBox("FRN", (Model.FRN > 0 ? Model.FRN.ToString() : ""), new { data_val_number = "The field FRN must be a number.", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.FRN, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="row" style="margin-bottom:10px;">
        <div class="form-group">
            @Html.LabelFor(model => model.SchemeYear, new { @class = "control-label col-md-3" })
            <div class="col-md-7">
                @Html.TextBox("SchemeYear", (Model.SchemeYear > 0 ? Model.SchemeYear.ToString() : ""), new { data_val_number = "The field Scheme Year must be a number.", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.SchemeYear, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-3 col-md-9">
            <input type="button" value="Create" id="createSup" class="btn btn-primary" />
        </div>
    </div>

    @Html.HiddenFor(model => model.SuppressionID)

}

<script>
    $("#createSup").click(function (event) {

        event.preventDefault();

        $.ajax({
            type: 'POST',
            url: '@Url.Action("_CreateSuppression")',
            data: $("#frmCreateSuppression").serialize(),
            success: function (data) {
                if (data.Ok) {
                    $('#existingHolder').load('@Url.Action("_Existing")');
                    $('#createHolder').load('@Url.Action("_CreateSuppression")');
                }
                else {
                    alert('Invalid FRN/Scheme Year combination');
                }
            }
        });
    });
</script>
