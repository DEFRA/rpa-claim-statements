@page "/Home/Index/{id?}"
@model RPA.ClaimStatements.Web.Pages.Home.IndexModel
@{
    ViewBag.Title = "Claim Statements";
}

<div class="jumbotron">
    <h2>Claim Statement Generator Web Portal</h2>

    @if (User.IsInRole("Claim Statement Generator: Trigger Generation"))
    {
        <div class="row">
            <div class="col-md-4">
                @await Html.PartialAsync("_TriggerGeneration")
            </div>
        </div>

    }

    <div class="row">
        @if (User.IsInRole("Claim Statement Generator: View Claim Statements"))
        {
            <div class="col-md-6">
                <h3><a href="@Url.Page("/Suppression/Index")">Suppressions</a></h3>
                <p>View and manage Claim Statement suppressions.</p>

                <h3><a href="@Url.Page("/Error/Index")">Generation Errors</a></h3>
                <p>View and manage Claim Statement generation and validation errors.</p>

                <h3><a href="@Url.Page("/Log/Index")">Generation Log</a></h3>
                <p>View details of all generated Claim Statements.</p>
            </div>
        }
        <div class="col-md-6">
            @if (User.IsInRole("Claim Statement Generator: View Claim Statements"))
            {
                <h3><a href="@Url.Page("/Home/Sample", new { statementType = "BPS" })">Download Sample Statement</a></h3>
                <p>Dowload a sample BPS Claim Statement.</p>

                <h3><a href="@Url.Page("/Home/Sample", new { statementType = "XB" })">Download Sample Statement (XB)</a></h3>
                <p>Dowload a sample BPS Cross Border Claim Statement.</p>
            }

            @if (User.IsInRole("Claim Statement Generator: Trigger Generation"))
            {
                <h3><a href="@Url.Page("/Configuration/Index")">Configuration</a></h3>
                <p>Configuration options for Claim Statement Generator.</p>

            }
        </div>
    </div>
</div>
