@model PagedList<RPA.ClaimStatements.Generator.Models.Entities.CS.Suppression>

@using PagedList.Mvc;
@using PagedList;

<div class="col-md-12">
    @if (Model.Count() > 0)
    {
        <table class="table table-condensed table-hover">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model[0].FRN)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model[0].SuppressionStart)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model[0].SchemeYear)
                </th>
                <th></th>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.FRN)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.SuppressionStart)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.SchemeYear)
                    </td>
                    <td>
                        @if (User.IsInRole("Claim Statement Generator: Manage Suppressions"))
                        {
                            <a class="remove" data-id="@item.SuppressionID" href="javascript:void(0)">Remove</a>
                        }
                    </td>
                </tr>
            }

        </table>

        <div id="pagerHolder" class="row">
            <div class="col-md-12">
                @Html.PagedListPager(Model, page => Url.Action("_Existing", new { ViewBag.searchData, page, pageSize = Model.PageSize }))
                Showing @(Model.TotalItemCount < Model.FirstItemOnPage ? 0 : Model.FirstItemOnPage) to @Model.LastItemOnPage of @Model.TotalItemCount suppressions
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-6">
                <div class="alert alert-warning">
                    <p>No current suppressions.</p>
                </div>
            </div>
        </div>
    }
</div>

<script>

    $('.remove').click(function () {

        var id = $(this).data("id");
        var button = this;

        $.ajax({
            url: '@Url.Action("RemoveSuppression")',
            traditional: true,
            data: { id: id },
            cache: false,
            success: function (data, status) {
                $(button).parent().parent().remove();
            }
        });
    });

    $(function () {
        $('#pagerHolder').on('click', 'a', function () {
            $.ajax({
                url: this.href,
                type: 'GET',
                cache: false,
                success: function (result) {
                    $('#existingHolder').html(result);
                }
            });
            return false;
        });
    });


</script>
