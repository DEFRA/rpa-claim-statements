@{
    ViewBag.Title = "Claim Statements";
}

<div class="jumbotron">
    <h2>Claim Statement Generator Web Portal</h2>

    @if (User.IsInRole("Claim Statement Generator: Trigger Generation"))
    {
        <div class="row">
            <div class="col-md-4">
                @Html.Partial("_TriggerGeneration")
            </div>
        </div>

    }

    <div class="row">
        @if (User.IsInRole("Claim Statement Generator: View Claim Statements"))
        {
            <div class="col-md-6">
                <h3>@Html.ActionLink("Suppressions", "Index", "Suppression")</h3>
                <p>View and manage Claim Statement suppressions.</p>

                <h3>@Html.ActionLink("Generation Errors", "Index", "Error")</h3>
                <p>View and manage Claim Statement generation and validation errors.</p>

                <h3>@Html.ActionLink("Generation Log", "Index", "Log")</h3>
                <p>View details of all generated Claim Statements.</p>
            </div>
        }
        <div class="col-md-6">
            @if (User.IsInRole("Claim Statement Generator: View Claim Statements"))
            {
                <h3>@Html.ActionLink("Download Sample Statement", "Sample", "Home", new { statementType = "BPS" }, null)</h3>
                <p>Dowload a sample BPS Claim Statement.</p>

                <h3>@Html.ActionLink("Download Sample Statement (XB)", "Sample", "Home", new { statementType = "XB" }, null)</h3>
                <p>Dowload a sample BPS Cross Border Claim Statement.</p>
            }

            @if (User.IsInRole("Claim Statement Generator: Trigger Generation"))
            {
                <h3>@Html.ActionLink("Configuration", "Index", "Configuration")</h3>
                <p>Configuration options for Claim Statement Generator.</p>

            }
        </div>
    </div>
</div>

