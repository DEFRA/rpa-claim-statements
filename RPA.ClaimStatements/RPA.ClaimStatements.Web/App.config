<?xml version="1.0" encoding="utf-8"?>
<!--
  Read through ConfigurationManager from RPA.ClaimStatements.Web.dll.config (Program.cs points the
  runtime at it explicitly so that it is also found when hosted in-process by IIS).
  The per-configuration transforms App.<Configuration>.config are applied by SlowCheetah at build time.
-->
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <sectionGroup name="system.net">
      <sectionGroup name="mailSettings">
        <section name="smtp" type="RPA.ClaimStatements.Generator.Services.SmtpSettingsSection, RPA.ClaimStatements.Generator" />
      </sectionGroup>
    </sectionGroup>
  </configSections>
  <appSettings>
    <!-- Application name used for the role lookup in the Security database (was applicationName on the IDT role provider). -->
    <add key="IDTSecurityApplicationName" value="/" />
  </appSettings>
  <connectionStrings>
    <add name="ClaimStatementsContext" connectionString="Data Source=.\sqlexpress; Initial Catalog=RPA.ClaimStatements; Integrated Security=True; MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />
    <add name="IDTSecurityConnection" connectionString="Data Source=.\sqlexpress;Initial Catalog=Security;Integrated Security=True;Pooling=False;Trusted_Connection=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="SpecifiedPickupDirectory">
        <specifiedPickupDirectory pickupDirectoryLocation="\\D1VMSMA001\inetpub\mailroot\Pickup" />
      </smtp>
    </mailSettings>
  </system.net>
</configuration>
