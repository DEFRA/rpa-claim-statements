<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
    <PackageReference Include="OpenTelemetry" Version="1.21.0" />
    <PackageReference Include="CsvHelper" Version="2.16.3" />
    <!-- Minimum version required by Clippit 3.9.1. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="EPPlus" Version="4.5.3.3" />
    <PackageReference Include="FastMember" Version="1.5.0" />
    <PackageReference Include="FluentFTP" Version="55.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="NBuilder" Version="6.1.0" />
    <PackageReference Include="Clippit" Version="3.9.1" />
    <!-- Without this pin EPPlus 4.5.3.3 resolves System.Drawing.Common 4.7.0 (critical advisory GHSA-rxg9-xrhp-64gj). -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <!-- Raises the transitive Pkcs from Microsoft.Data.SqlClient above GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Unity" Version="5.11.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RPA.ClaimStatements.Generator.Tests" />
    <Content Include="Rendering\render_pdf.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="XSLT\*.xslt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>