<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RPA.ClaimStatements.Web.Tests</RootNamespace>
    <AssemblyName>RPA.ClaimStatements.Web.Tests</AssemblyName>
    <Configurations>Debug;Release;Test;SIT;Production;UAT</Configurations>
    <Platforms>AnyCPU</Platforms>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Test' Or '$(Configuration)' == 'SIT'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <!-- ARControllerTests was never part of the legacy test build; it stays in git, unchanged. -->
  <ItemGroup>
    <Compile Remove="Controllers\ARControllerTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPA.ClaimStatements.Generator\RPA.ClaimStatements.Generator.csproj" />
    <ProjectReference Include="..\RPA.ClaimStatements.Web\RPA.ClaimStatements.Web.csproj" />
  </ItemGroup>

</Project>
